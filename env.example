GITHUB_API_URL=https://api.github.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
GENIUS_WORKSPACE_DIR=.genius/workspaces
GENIUS_INDEX_PATH=.genius/index.sqlite3
GENIUS_MAX_FILE_BYTES=350000
GENIUS_MAX_REPO_FILES=8000
GENIUS_REQUEST_TIMEOUT_SECONDS=60
GENIUS_API_TOKEN=
GENIUS_API_RATE_LIMIT_PER_MINUTE=60
GENIUS_AUDIT_LOG_PATH=.genius/audit.jsonl
GENIUS_ALLOW_INCOMPATIBLE_LICENSE_COPY=false


# Optional Laya/Jev-compatible System-One task classifier.
# Existing explicit task intent, security policy and license policy remain authoritative.
GENIUS_SYSTEM_ONE_MODE=off
GENIUS_SYSTEM_ONE_BASE_URL=http://127.0.0.1:8000
GENIUS_SYSTEM_ONE_API_KEY=
GENIUS_SYSTEM_ONE_TIMEOUT_SECONDS=1.5
